# Frontend Environment Variables
# Copy this file to .env.local and update values for your environment

# API Configuration
# Backend API URL (without /api suffix - added automatically by the API client)
# Development: http://localhost:8030
# Production: https://api.gradvy.com or https://gradvy.com
# IMPORTANT: Do not include trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8030

# Environment
NODE_ENV=development

# Other configuration
NEXT_PUBLIC_APP_NAME=Gradvy
NEXT_PUBLIC_APP_VERSION=1.0.0